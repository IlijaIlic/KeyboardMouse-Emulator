    <string notr="true">QPushButton[buttonType=&quot;accept&quot;] {
    background-color: #97d299;
    color: #32a135;
	font-weight: 800;
}

QPushButton[buttonType=&quot;decline&quot;] {
    background-color: #E05252;
    color: white;
	font-weight: bold;
}

QPushButton[buttonType=&quot;accept&quot;]:hover {
    background-color: #64bc67;
}

QPushButton[buttonType=&quot;decline&quot;]:hover {
    background-color: #E05050;
}

QWidget#mainBackground{
